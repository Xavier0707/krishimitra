# KrishiConnect AI Environment Configuration

# Next.js Public Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="KrishiConnect AI"
NEXT_PUBLIC_DEFAULT_REGION="Madhya Pradesh"

# Supabase Database & Auth (Optional for Demo Mode, Required for Multi-device Auth)
# If left blank, KrishiConnect automatically falls back to secure Local Demo Mode!
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
# SUPABASE_SERVICE_ROLE_KEY is server-side ONLY. Never expose in NEXT_PUBLIC_ variables.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Weather API (Open-Meteo is free and open, no key required by default)
# You can set an optional custom base URL if using commercial high-frequency endpoints.
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1

# Agricultural Market Data (data.gov.in / Agmarknet)
# Register at https://data.gov.in to get an API key for live Agmarknet mandi feeds.
# If unset, KrishiConnect utilizes validated local MP Agmarknet cached feeds.
DATA_GOV_IN_API_KEY=your_data_gov_in_api_key_here

# AI Assistance (Modular LLM Provider - e.g. Google Gemini or OpenAI)
AI_PROVIDER=gemini # 'gemini' | 'openai' | 'mock'
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
